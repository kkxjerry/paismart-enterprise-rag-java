{
  "schema_version": 1,
  "name": "enterpriserag-qwen3-parent-child-e3-v1",
  "base_dir": "../..",
  "arguments": {
    "run-id": "enterpriserag-qwen3-parent-child-e3-v1",
    "questions": "data/enterpriserag/questions.json",
    "output": "runs/enterpriserag-qwen3-parent-child-e3-v1-summary.json",
    "details-output": "runs/enterpriserag-qwen3-parent-child-e3-v1-details.jsonl",
    "manifest-output": "runs/enterpriserag-qwen3-parent-child-e3-v1-manifest.json",
    "evidence-output": "runs/enterpriserag-qwen3-parent-child-e3-v1-contexts.jsonl",
    "es-url": "http://127.0.0.1:19200",
    "engine": "elasticsearch",
    "index": "knowledge_base_benchmark_qwen3_4b_2048_parent_child_e3_v1",
    "embedding-url": "http://127.0.0.1:18084/v1/embeddings",
    "embedding-api-format": "local",
    "embedding-model": "Qwen/Qwen3-Embedding-4B",
    "embedding-dimension": 2048,
    "embedding-query-instruction": "Given an enterprise search query, retrieve relevant passages that answer the query",
    "retrieval-mode": "hybrid",
    "retriever-k": 50,
    "dense-chunk-candidates": 500,
    "dense-num-candidates": 2500,
    "rrf-k": 10,
    "dense-weight": 0.75,
    "bm25-weight": 0.50,
    "keyword-bm25-enabled": true,
    "keyword-bm25-weight": 1.25,
    "english-bm25-enabled": true,
    "english-bm25-weight": 1.50,
    "top-k": 50,
    "evidence-enabled": true,
    "evidence-top-documents": 10,
    "evidence-candidate-chunks-per-document": 12,
    "evidence-chunks-per-document": 3,
    "evidence-token-budget": 6000,
    "evidence-per-document-token-budget": 1200,
    "evidence-max-chunk-tokens": 512,
    "evidence-redundancy-penalty": 0.35,
    "progress-every": 25
  },
  "inputs": {
    "questions": "data/enterpriserag/questions.json",
    "documents": "data/enterpriserag/docs.jsonl",
    "acl_documents": "data/enterpriserag/acl_docs.jsonl",
    "index_mapping": "config/elasticsearch-parent-child-2048.json"
  },
  "metadata": {
    "dataset": "onyx-dot-app/EnterpriseRAG-Bench",
    "experiment": "E3 source-specific parent-child index",
    "changed_sources": ["confluence", "google_drive", "gmail", "fireflies"],
    "control_sources": ["jira", "linear", "slack", "github", "hubspot"],
    "retrieval_unit": "source-specific leaf",
    "generation_unit": "stored verbatim parent",
    "context_prefix_enabled": true,
    "leaf_chunk_size": 500,
    "leaf_overlap": 50,
    "safety": "new isolated index; no alias promotion"
  }
}
