{
  "schema_version": 1,
  "name": "enterpriserag-qwen3-four-route-evidence-v1",
  "base_dir": "../..",
  "arguments": {
    "run-id": "enterpriserag-qwen3-four-route-evidence-v1",
    "questions": "data/enterpriserag/questions.json",
    "output": "runs/enterpriserag-qwen3-four-route-evidence-v1-summary.json",
    "details-output": "runs/enterpriserag-qwen3-four-route-evidence-v1-details.jsonl",
    "manifest-output": "runs/enterpriserag-qwen3-four-route-evidence-v1-manifest.json",
    "evidence-output": "runs/enterpriserag-qwen3-four-route-evidence-v1-contexts.jsonl",
    "es-url": "http://127.0.0.1:19200",
    "engine": "elasticsearch",
    "index": "knowledge_base_benchmark_qwen3_4b_2048_evidence_v2",
    "embedding-url": "http://127.0.0.1:18084/v1/embeddings",
    "embedding-api-format": "local",
    "embedding-model": "Qwen/Qwen3-Embedding-4B",
    "embedding-dimension": 2048,
    "embedding-query-instruction": "Given an enterprise search query, retrieve relevant passages that answer the query",
    "retrieval-mode": "hybrid",
    "retriever-k": 50,
    "dense-chunk-candidates": 500,
    "dense-num-candidates": 2500,
    "rrf-k": 10,
    "dense-weight": 0.75,
    "bm25-weight": 0.50,
    "keyword-bm25-enabled": true,
    "keyword-bm25-weight": 1.25,
    "english-bm25-enabled": true,
    "english-bm25-weight": 1.50,
    "top-k": 50,
    "evidence-enabled": true,
    "evidence-top-documents": 10,
    "evidence-candidate-chunks-per-document": 8,
    "evidence-chunks-per-document": 3,
    "evidence-token-budget": 6000,
    "evidence-per-document-token-budget": 1200,
    "evidence-max-chunk-tokens": 512,
    "evidence-redundancy-penalty": 0.35,
    "progress-every": 25
  },
  "inputs": {
    "questions": "data/enterpriserag/questions.json",
    "documents": "data/enterpriserag/docs.jsonl",
    "acl_documents": "data/enterpriserag/acl_docs.jsonl",
    "index_mapping": "config/elasticsearch-evidence-2048.json"
  },
  "metadata": {
    "dataset": "onyx-dot-app/EnterpriseRAG-Bench",
    "baseline": {
      "name": "Qwen3 four-route weighted RRF",
      "questions_total": 500,
      "questions_evaluable": 470,
      "hit_at_10": 0.9808510638297872,
      "misses_at_10": 9,
      "source_index": "knowledge_base_benchmark_qwen3_4b_2048_v1",
      "document_ranking_policy": "frozen; the evidence-v2 index must reproduce the historical ranking before answer evaluation"
    },
    "embedding": {
      "model": "Qwen/Qwen3-Embedding-4B",
      "native_dimension": 2560,
      "stored_dimension": 2048,
      "dimension_strategy": "service_adapter_first_2048_then_l2_normalize",
      "compatibility_note": "The current vLLM runtime returns the native 2560 dimensions. The existing 2048-dimensional index requires an explicit adapter; a native 2560-dimensional control remains a separate experiment."
    },
    "runtime": {
      "embedding_server": "vLLM",
      "verified_version": "0.17.0"
    },
    "evidence": {
      "mode": "java_evidence_builder",
      "selection": "bounded lexical candidates plus retained multi-route chunks",
      "conflict_policy": "preserve_and_mark",
      "citation_granularity": "one citation per selected chunk"
    }
  }
}
